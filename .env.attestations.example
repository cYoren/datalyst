# Server-side only. Offchain signing requires no ETH, RPC, or schema registration.
ATTESTATION_MODE=offchain
EAS_SIGNER_PRIVATE_KEY=
# Optional public signer allowlist for verification without private-key access.
EAS_TRUSTED_SIGNER_ADDRESS=
# Only needed for opt-in onchain mode / verification of onchain bundles.
BASE_RPC_URL=
# Populate with manual scripts/register-eas-schemas.mjs output.
EAS_PREREG_SCHEMA_UID=
EAS_RESULTS_SCHEMA_UID=
