{
  "name": "datalyst",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:preview": "NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL:-http://localhost:54321} NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY:-preview} next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "scripts/deploy-cloudflare.sh",
    "lint": "eslint",
    "test": "vitest run",
    "check:migrations": "node scripts/check-migration-baseline.mjs",
    "test:watch": "vitest",
    "test:e2e:mobile": "playwright test e2e/mobile-checkin.spec.ts --project=mobile-chromium",
    "screenshots:stores": "node scripts/generate-appstore-screenshots.js",
    "postinstall": "prisma generate && node scripts/fix-apple-sign-in-plugin.mjs",
    "cap:sync:ios": "cap sync ios",
    "ios:ci:prepare": "npm run build && npm run cap:sync:ios"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "7.1.0",
    "@capacitor-community/in-app-review": "8.0.0",
    "@capacitor/android": "8.3.4",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.3.4",
    "@capacitor/ios": "8.3.4",
    "@capacitor/local-notifications": "8.3.1",
    "@capgo/capacitor-health": "8.11.4",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.39.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.554.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "prisma": "^6.19.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.5.0",
    "simple-statistics": "^7.8.8",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "viem": "2.55.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.4",
    "@opennextjs/cloudflare": "^1.20.14",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.152.0"
  }
}
