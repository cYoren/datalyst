# Self-hosted mode: one local user, no login, no Supabase.
NEXT_PUBLIC_DATALYST_SELF_HOSTED=1
DATABASE_URL=postgresql://datalyst:datalyst@localhost:5432/datalyst

# Optional: require a password (HTTP Basic, any username).
DATALYST_PASSWORD=

# Optional: AI explanations of your results, with any LLM.
# OpenAI-compatible by default (OpenAI, OpenRouter, Groq, Mistral, Gemini, DeepSeek, Ollama, LM Studio).
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=            # e.g. https://openrouter.ai/api/v1 or http://localhost:11434/v1 (Ollama, no key)
AI_PROVIDER=            # "anthropic" for Claude
AI_PROVIDER_NAME=       # shown in the consent text
AI_INPUT_USD_PER_MTOK=  # for the daily budget; 0 for local models
AI_OUTPUT_USD_PER_MTOK=
# AI_DAILY_LIMIT_USD=0.10   # per user per day, capped at 1. Leave commented for the default.
AI_RUNS_PER_MINUTE=     # per user per capability; default 6

# One switch per capability. With every switch off no request reaches a provider and the
# app is the deterministic product: check-in, statistics and Lab all keep working.
# AI_ENABLED=off beats every line below.
AI_ENABLED=
AI_FEATURE_INSIGHTS=          # shipped, on by default
AI_FEATURE_QUICK_LOG=         # shipped, on by default
AI_FEATURE_PROTOCOL_BUILDER=  # not shipped, off by default
AI_FEATURE_EXPERIMENT_PLANNER= # not shipped, off by default
AI_FEATURE_NEXT_OBSERVATION=  # not shipped, off by default

# Cloud mode only (leave NEXT_PUBLIC_DATALYST_SELF_HOSTED empty):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
